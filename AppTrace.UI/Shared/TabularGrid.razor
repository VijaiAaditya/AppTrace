@* Reusable, virtualized grid bound directly to a TabularResult (columns + rows array).
   No per-record property reflection - iterates raw string[] columns and object?[][] rows,
   which keeps rendering cheap even for tens of thousands of records. *@
@using AppTrace.Common.Models

<div class="table-responsive" style="height: 70vh; overflow-y: auto;">
    <table class="table table-striped table-sm">
        <thead style="position: sticky; top: 0; background: white;">
            <tr>
                @foreach (var column in Result?.Columns ?? [])
                {
                    <th>@column</th>
                }
            </tr>
        </thead>
        <tbody>
            @if (Result is not null && Result.Rows.Length > 0)
            {
                <Virtualize Items="Result.Rows" Context="row" OverscanCount="20">
                    <tr>
                        @foreach (var cell in row)
                        {
                            <td>@FormatCell(cell)</td>
                        }
                    </tr>
                </Virtualize>
            }
            else
            {
                <tr><td colspan="@((Result?.Columns.Length) ?? 1)">No records found.</td></tr>
            }
        </tbody>
    </table>
</div>

@code {
    [Parameter] public TabularResult? Result { get; set; }

    private static string FormatCell(object? value) => value switch
    {
        null => string.Empty,
        DateTimeOffset dto => dto.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss.fff"),
        double d => d.ToString("N2"),
        _ => value.ToString() ?? string.Empty
    };
}
