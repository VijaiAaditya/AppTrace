@page "/traces"
@using AppTrace.Common.Models
@inject HttpClient Http

<PageTitle>Traces</PageTitle>

<h1>Traces</h1>

<div class="mb-3 d-flex gap-2">
    <input class="form-control" style="max-width: 300px;" placeholder="Trace ID (optional)" @bind="_traceId" @bind:event="oninput" />
    <button class="btn btn-primary" @onclick="LoadAsync">Load</button>
    <select class="form-select" style="max-width: 150px;" @bind="_pageSize">
        <option value="100">100</option>
        <option value="1000">1,000</option>
        <option value="10000">10,000</option>
        <option value="100000">100,000</option>
    </select>
    <a class="btn btn-outline-secondary" href="@($"{Http.BaseAddress}api/export/traces?page=1&pageSize={_pageSize}")" target="_blank">Export CSV</a>
</div>

@if (_error is not null)
{
    <div class="alert alert-danger">@_error</div>
}
else if (_result is null)
{
    <p><em>Loading...</em></p>
}
else
{
    <p>@_result.TotalCount total record(s) - page @_result.Page</p>
    <TabularGrid Result="_result" />
    <div class="d-flex gap-2 mt-2">
        <button class="btn btn-secondary" disabled="@(_page <= 1)" @onclick="PreviousPage">Previous</button>
        <button class="btn btn-secondary" @onclick="NextPage">Next</button>
    </div>
}

@code {
    private TabularResult? _result;
    private string? _error;
    private string _traceId = string.Empty;
    private int _page = 1;
    private int _pageSize = 100;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var url = string.IsNullOrWhiteSpace(_traceId)
                ? $"api/traces?page={_page}&pageSize={_pageSize}"
                : $"api/traces/{Uri.EscapeDataString(_traceId)}";

            _result = await Http.GetFromJsonAsync<TabularResult>(url);
        }
        catch (Exception ex)
        {
            _error = $"Failed to load traces: {ex.Message}";
        }
    }

    private Task NextPage()
    {
        _page++;
        return LoadAsync();
    }

    private Task PreviousPage()
    {
        if (_page > 1) _page--;
        return LoadAsync();
    }
}
